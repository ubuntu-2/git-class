pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        APP = "billing-api"
        VERSION = "1.4.1"
    }

    stages {
        stage('Build') {
            steps {
                echo "Double quotes - Groovy fills it in: ${APP} ${VERSION}"
                echo 'Single quotes - Groovy leaves it: ${APP} ${VERSION}'
                sh 'echo Single quotes in sh - the shell fills it in: $APP $VERSION'
            }
        }
         stage('Lint') {
            steps{
                sh 'exit 1'
             }
         }
     }
}

                                                                       

