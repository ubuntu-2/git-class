pipeline {
    agent any
    
    stages {
        stage('Build') {
            steps {
                echo "Building the application..."
            }
        }
        
        stage('Approval') {
            steps {
                input message: "Approve deployment to production?", ok: "Ship it!"
            }
        }
        
        stage('Deploy') {
            steps {
                echo "Deploying to production successfully!"
            }
        }
    }
}
                                                                       

