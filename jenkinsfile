pipeline {
    agent any
    
    stages {
        stage('Retry Example') {
            steps {
                echo "Trying up to 3 times if something fails..."
                retry(3) {
                    sh 'echo "Attempting task..."; exit 1'
                }
            }
        }
        
        stage('CatchError Example') {
            steps {
                echo "Catching error without failing the whole pipeline..."
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh 'exit 1'
                }
            }
        }
        
        stage('Timeout Example') {
            steps {
                echo "Waiting with a timeout limit..."
                timeout(time: 10, unit: 'SECONDS') {
                    sh 'sleep 5'
                }
            }
        }
    }
}
    post {
        always {
            echo "POST: This will ALWAYS run, regardless of success or failure."
        }
        success {
            echo "POST: This runs ONLY if the build succeeds."
        }
        failure {
            echo "POST: This runs ONLY if the build fails."
        }
    }
}

                                                                       

