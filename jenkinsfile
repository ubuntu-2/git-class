pipeline {
    agent any
    
    parameters {
        booleanParam(name: 'SHOULD_FAIL', defaultValue: false, description: 'Fail build intentionally')
    }
    
    stages {
        stage('Build') {
            steps {
                echo "Running build stage..."
                script {
                    if (params.SHOULD_FAIL) {
                        error("Intentional failure triggered!")
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo "POST: This will ALWAYS run, regardless of success or failure."
        }
        success {
            echo "POST: This runs ONLY if the build succeeds."
        }
        failure {
            echo "POST: This runs ONLY if the build fails."
        }
    }
}

                                                                       

