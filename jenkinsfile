pipeline {
    agent any
    
    stages {
        stage('Use Credentials') {
            steps {
                echo "Accessing secure credentials..."
                withCredentials([string(credentialsId: 'demo-token', variable: 'SECRET_KEY')]) {
                    sh 'echo "The token is: ****"'
                    sh 'echo "The token is ${#SECRET_KEY} characters long"'
                    sh 'echo "Warning: insecure Groovy String interpolation."'
                    sh 'echo "Reversed: $(echo ${SECRET_KEY} | rev)"'
                }
            }
        }
    }
}
                                                    

